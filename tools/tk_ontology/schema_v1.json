{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensor-ecosystem/knowledge/ontology/schema_v1.json",
  "title": "Tensor knowledge object (KO) schema v1",
  "description": "Machine-callable knowledge object for the ship-hydrodynamics / numerical-methods agent ecosystem. Six forms describe what a knowledge object IS (not what it is about); two axes describe what it is about (method axis x domain axis). Every field that is not established carries the explicit value null plus a field_confidence entry of 'unknown', so a consumer never has to guess between 'absent' and 'not established'.",
  "type": "object",
  "required": [
    "id",
    "form",
    "title",
    "method_axis",
    "domain_axis",
    "provenance",
    "fields",
    "field_confidence",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(CASE|METHOD|CRITERION|EVIDENCE|DEFECT|CONTRACT)-[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier; the prefix MUST equal the form (enforced here and re-checked by the compiler). The suffix preserves the repository's own bookmark/anchor spelling verbatim - the ontology never renames an object a human already cites."
    },
    "form": {
      "enum": [
        "CASE",
        "METHOD",
        "CRITERION",
        "EVIDENCE",
        "DEFECT",
        "CONTRACT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "method_axis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FEM",
          "LBM",
          "FVM",
          "BEM",
          "SPH",
          "DEM",
          "DG",
          "CAD",
          "ANALYTIC",
          "EXPERIMENT"
        ]
      }
    },
    "domain_axis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resistance",
          "propulsion",
          "seakeeping",
          "manoeuvring",
          "stability",
          "structure",
          "vibration_noise",
          "green",
          "ice",
          "contact",
          "heat_transfer",
          "general_mechanics"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "repo",
        "path",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Further documents about the same object (one object may be described by several files; the first path is the primary source)."
        }
      }
    },
    "fields": {
      "type": "object"
    },
    "field_confidence": {
      "$ref": "#/$defs/confidence"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verb",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "verb": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "form": {
            "const": "CASE"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/case_fields"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "METHOD"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/method_fields"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "CRITERION"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/criterion_fields"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "EVIDENCE"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/evidence_fields"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "DEFECT"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/defect_fields"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "CONTRACT"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "$ref": "#/$defs/contract_fields"
          }
        }
      }
    }
  ],
  "$defs": {
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "measured",
          "parsed",
          "declared",
          "unknown"
        ]
      }
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_fields": {
      "type": "object",
      "required": [
        "code",
        "tier",
        "benchmark_reference",
        "tolerance_text",
        "run_command",
        "artifact_paths",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/nullable_string"
        },
        "benchmark_reference": {
          "$ref": "#/$defs/nullable_string"
        },
        "tolerance_text": {
          "$ref": "#/$defs/nullable_string"
        },
        "run_command": {
          "$ref": "#/$defs/nullable_string"
        },
        "artifact_paths": {
          "$ref": "#/$defs/string_list"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "method_fields": {
      "type": "object",
      "required": [
        "name",
        "family",
        "applicability",
        "validity_limits",
        "implementation_paths",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "applicability": {
          "type": "string"
        },
        "validity_limits": {
          "$ref": "#/$defs/string_list"
        },
        "implementation_paths": {
          "$ref": "#/$defs/string_list"
        },
        "references": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "criterion_fields": {
      "type": "object",
      "required": [
        "metric",
        "comparator",
        "threshold_pct",
        "unit",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string"
        },
        "comparator": {
          "enum": [
            "<",
            "<=",
            ">=",
            ">",
            "unknown"
          ]
        },
        "threshold_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "percent",
            "absolute",
            "unknown"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "evidence_fields": {
      "type": "object",
      "required": [
        "case_id",
        "artifact_path",
        "declared_grade",
        "mechanical_grade",
        "grade_basis",
        "sha256",
        "n_numeric_leaf"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "artifact_path": {
          "$ref": "#/$defs/nullable_string"
        },
        "declared_grade": {
          "enum": [
            "REAL",
            "MOCK",
            "STUB",
            "WITHHELD",
            "NOT_SUPPORTED",
            "UNKNOWN"
          ]
        },
        "mechanical_grade": {
          "enum": [
            "REAL",
            "MOCK",
            "STUB",
            "WITHHELD",
            "NOT_SUPPORTED"
          ]
        },
        "grade_basis": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/nullable_string"
        },
        "n_numeric_leaf": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "defect_fields": {
      "type": "object",
      "required": [
        "symptom",
        "severity",
        "scope",
        "refuted_claim",
        "evidence_path"
      ],
      "additionalProperties": false,
      "properties": {
        "symptom": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "UNKNOWN"
          ]
        },
        "scope": {
          "type": "string"
        },
        "refuted_claim": {
          "$ref": "#/$defs/nullable_string"
        },
        "evidence_path": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "contract_fields": {
      "type": "object",
      "required": [
        "scope",
        "obligations",
        "tolerance_policy",
        "consumer"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string"
        },
        "obligations": {
          "$ref": "#/$defs/string_list"
        },
        "tolerance_policy": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        }
      }
    }
  }
}
